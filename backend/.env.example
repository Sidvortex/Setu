# Setu backend settings (read by config.py). Copy to .env for local use; on Render set them as environment variables (see render.yaml / DEPLOY.md).
SETU_ENV=development                 # production = refuse to start with an insecure AUTH_SECRET
AUTH_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=*                    # production: your site, e.g. https://setu.vercel.app (comma-separated)

TURSO_DATABASE_URL=                  # required when deployed (Render's disk is wiped when the server sleeps)
TURSO_AUTH_TOKEN=

BHOOSURAKSHA_API_URL=                # e.g. https://bhoosuraksha-backend-xxxx.a.run.app
BHOOSURAKSHA_TIMEOUT_S=4
RISK_CACHE_MINUTES=30
RISK_FAILURE_COOLDOWN_S=120          # after a failed call, skip BhooSuraksha for this long

AI_PROVIDER=                         # gemini | anthropic (optional photo check)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=                            # optional override of the default model name
